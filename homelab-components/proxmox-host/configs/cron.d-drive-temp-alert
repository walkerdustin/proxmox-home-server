# /etc/cron.d/drive-temp-alert  --  Proxmox host `pve`
#
# Every 20 minutes, on :00 / :20 / :40 -- deliberately clear of the capacity
# alert (:25), sanoid (:00/:04 daily) and the Sunday scrub (03:00).
#
# Deliberately NOT sharing Scrutiny's collector cron: one cron line running two
# jobs means a failure in either kills both, and a change to the collector's
# schedule would silently change this alert too.
#
# Output goes to the journal because this host delivers cron mail to root, and
# a chatty cron job would mail on every run:
#
#   journalctl -t drive-temp-alert --since today
#
# The script exits 1 while any drive is over its limit. That is expected, not a
# failure -- it is there so an interactive run has a useful exit status.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/20 * * * * root /usr/local/sbin/drive-temp-alert.sh 2>&1 | logger -t drive-temp-alert
