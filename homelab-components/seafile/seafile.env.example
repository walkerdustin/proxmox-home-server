#################################
# Docker compose configurations #
#################################
# seadoc.yml intentionally removed - the file is not downloaded, and Compose
# fails on a missing file listed here.
COMPOSE_FILE='seafile-server.yml,caddy.yml'
COMPOSE_PATH_SEPARATOR=','

## Images
# Consider pinning an exact patch tag instead of the moving 13.0-latest.
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0-latest
SEAFILE_DB_IMAGE=mariadb:10.11
SEAFILE_REDIS_IMAGE=redis
SEAFILE_CADDY_IMAGE=lucaslorentz/caddy-docker-proxy:2.12-alpine
# Unused while SeaDoc / notifications / metadata server are off:
# SEADOC_IMAGE=seafileltd/sdoc-server:2.0-latest
# NOTIFICATION_SERVER_IMAGE=seafileltd/notification-server:13.0-latest
# MD_IMAGE=seafileltd/seafile-md-server:13.0-latest

## Persistent Storage
# Explicit paths override BASIC_STORAGE_PATH. Block store lives on the tank
# RAIDZ1 vdisk; MariaDB lives on the SSD OS disk (RAIDZ1 HDD has no SLOG, so
# every SQL commit would be slow). Nightly dumps land on tank instead.
BASIC_STORAGE_PATH=/mnt/data/seafile
SEAFILE_VOLUME=/mnt/data/seafile/data
SEAFILE_MYSQL_VOLUME=/opt/seafile-mysql/db
SEAFILE_CADDY_VOLUME=/mnt/data/seafile/caddy

#################################
#      Startup parameters       #
#################################
SEAFILE_SERVER_HOSTNAME=cloud.dustinwalker.de
# MUST be https: drives both Caddy cert issuance and the upload links Seahub
# hands out. http here = working login, broken uploads.
SEAFILE_SERVER_PROTOCOL=https
TIME_ZONE=Europe/Berlin
# openssl rand -hex 32   (>= 32 chars required)
JWT_PRIVATE_KEY=REPLACE_ME_HEX64

#####################################
# Third-party service configuration #
#####################################

## Database
SEAFILE_MYSQL_DB_HOST=db
SEAFILE_MYSQL_DB_USER=seafile
# openssl rand -hex 24
SEAFILE_MYSQL_DB_PASSWORD=REPLACE_ME
SEAFILE_MYSQL_DB_CCNET_DB_NAME=ccnet_db
SEAFILE_MYSQL_DB_SEAFILE_DB_NAME=seafile_db
SEAFILE_MYSQL_DB_SEAHUB_DB_NAME=seahub_db

## Cache
CACHE_PROVIDER=redis

### Redis
# Only reachable on the internal seafile-net. Leave the password empty as
# shipped unless seafile-server.yml interpolates REDIS_PASSWORD into the
# redis command unconditionally - check before the first start.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

######################################
#        Initial variables           #
# (Only valid in first-time startup) #
######################################

## Database root password, used to create Seafile users
# openssl rand -hex 24   -- also needed later by backup-sql.sh
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=REPLACE_ME

## Seafile admin user
INIT_SEAFILE_ADMIN_EMAIL=admin@example.com
INIT_SEAFILE_ADMIN_PASSWORD=REPLACE_ME

############################################
# Additional configurations for extensions #
############################################

## SeaDoc service - off (no-office stance, saves ~400 MB on the 6 GB VM)
ENABLE_SEADOC=false

## Notification - off
ENABLE_NOTIFICATION_SERVER=false
NOTIFICATION_SERVER_URL=

## Seafile AI - off
ENABLE_SEAFILE_AI=false
ENABLE_FACE_RECOGNITION=false

## Metadata server
MD_FILE_COUNT_LIMIT=100000
